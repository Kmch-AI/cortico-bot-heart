{
  "name": "@kmchai/cortico-bot-heart",
  "version": "0.1.2",
  "type": "module",
  "description": "Kmch AI · 心：Cortico 的 bot 层。管理心情、关系、注意力与持久记忆，按信息来源决定文字/语音与是否开口；发送交给 World。",
  "author": "kmchai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kmch-AI/cortico-bot-heart.git"
  },
  "keywords": [
    "cortico-bot",
    "cortico",
    "memory",
    "mood",
    "systemone",
    "voice",
    "qq",
    "心",
    "记忆"
  ],
  "engines": {
    "node": ">=22.23"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./index.ts",
  "cortico": {
    "kind": "bot",
    "api": 7,
    "displayName": "Kmch AI · 心",
    "locales": {
      "zh": {
        "displayName": "Kmch AI · 心",
        "description": "Kmch AI · 心：Cortico 的 bot 层。管理心情、关系、注意力与持久记忆，按信息来源决定文字/语音与是否开口；发送交给 World。"
      },
      "en": {
        "displayName": "Kmch AI · Heart",
        "description": "Kmch AI · Heart: the bot layer for Cortico. Mood, relationships, attention and persistent memory; decides text or voice and whether to speak from each event's source; Worlds deliver."
      }
    },
    "tags": [
      "im",
      "qq",
      "voice",
      "memory",
      "companion",
      "high-cost",
      "sensitive-data",
      "external-setup",
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "index.ts",
    "config.ts",
    "persona",
    "state",
    "decision",
    "memory",
    "output",
    "dist/webui.js",
    "dist/webui.css",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:webui": "node scripts/build-webui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "sqlite-vec": "0.1.9"
  }
}
